{
  "name": "mano-a-mano",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Juego de preguntas y respuestas 1vs1 con preguntas generadas por IA a pedido.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "icons": "node scripts/gen-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
